#!name=Rule Injector - Proxy (Surge 6.8+)
#!desc=由 Surge 独立按需注入规则，适用于策略组名称为 Proxy 的配置。
#!category=Injector
#!system=mac

[Rule]
PROCESS-NAME,Antigravity,Proxy
PROCESS-NAME,antigravity,Proxy
PROCESS-NAME,Codex,Proxy
PROCESS-NAME,codex,Proxy
PROCESS-NAME,/Applications/UURemote.app/,DIRECT
RULE-SET,https://raw.githubusercontent.com/acherontia003/Surge-Rules/main/inject-rules.list,Proxy,update-interval=172800
